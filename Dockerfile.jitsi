# Jitsi Meet for Railway
FROM jitsi/web:latest

# Railway provides PORT env var
ENV PORT=8080

# Enable guest access (students join without auth)
ENV ENABLE_GUESTS=1

# Disable auth for student access (teachers get moderator via JWT)
ENV ENABLE_AUTH=0

# Disable P2P for better compatibility
ENV ENABLE_P2P=0

# Set default region
ENV DEFAULT_REGION=kenya

# Branding
ENV BRANDING_DATA='{"appName":"NET Kenya Virtual Classroom","headerLogoUrl":"","watermarkLink":""}'

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1