# Jitsi Meet for Railway
FROM jitsi/web:latest

# Railway provides PORT env var
ENV PORT=8080

# Guest access stays on so students (without tokens) can still join rooms.
# JWT token auth is enabled automatically by docker-entrypoint-jitsi.sh when the
# Railway env JWT_APP_SECRET is set (shared with the web service). That makes
# staff JWT tokens grant moderator rights.
ENV ENABLE_GUESTS=1

# Disable P2P for better compatibility
ENV ENABLE_P2P=0

# Set default region
ENV DEFAULT_REGION=kenya

# Branding
ENV BRANDING_DATA='{"appName":"NET Kenya Virtual Classroom","headerLogoUrl":"","watermarkLink":""}'

# Wrapper activates token auth when JWT_APP_SECRET is present, then runs /init
COPY docker-entrypoint-jitsi.sh /docker-entrypoint-jitsi.sh
RUN chmod +x /docker-entrypoint-jitsi.sh

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Override the image entrypoint with our wrapper
ENTRYPOINT []
CMD ["/docker-entrypoint-jitsi.sh"]